# Konfigurasi Server
#######################
# 🚪 PORT CONFIGURATION
#######################
HTTP_PORT=9020
HTTPS_PORT=8443
ENABLE_HTTPS=false
REDIRECT_HTTP=true

########################
# 🔐 JWT / Keycloak Auth
########################
JWT_REALM=spring-client-credentials-id
JWT_SERVER_URL=http://keycloak-auth:8080
JWT_CLIENT_ID=admin-cli
JWT_CLIENT_SECRET=jz0IOMSXyP0iAotSZuBsyf71mg0wtCZN

##########################
# 🧭 CONSUL CONFIGURATION
##########################
CONSUL_ADDR=http://consul-agent-gateway:8503
CONSUL_SERVICE_NAME=api-gateway
CONSUL_SERVICE_ID=api-gateway-1
CONSUL_SERVICE_HOST=api-gateway-1
CONSUL_SERVICE_PORT=9000

##########################
# 🏰 VAULT CONFIGURATION
##########################
VAULT_ENABLED=true
VAULT_HOST=vault-core
VAULT_PORT=8200
VAULT_SCHEME=http
VAULT_URI=http://vault-core:8200
VAULT_TOKEN=hvs.7itYmc32txc0J636Fvkmb4z4
VAULT_CONNECTION_TIMEOUT=5000
VAULT_READ_TIMEOUT=15000
VAULT_KV_BACKEND=kv
VAULT_DEFAULT_CONTEXT=auth-services

##############################
# 🚦 RATE LIMITING & CACHING
##############################
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_BURST=200
RATE_LIMIT_PERIOD=60
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=password
REDIS_DB=0

##################
# 📜 LOGGING
##################
LOG_LEVEL=info

##########################
# 🔗 SERVICE ENDPOINTS
##########################
AUTH_SERVICE_URL=http://auth-services.service.consul:9001

KAFKA_BROKERS=kafka:9092
KAFKA_LOG_TOPIC=log-app

OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
OTEL_SERVICE_NAME=api-gateway


